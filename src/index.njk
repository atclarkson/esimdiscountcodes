---
layout: base.njk
title: "eSIM Discount Codes - Best Promo Codes for International Travel"
description: "Find verified discount and promo codes for top eSIM providers. Save on Holafly, Airalo, Saily and more. Updated daily with working promo codes for international travel."
---

<div class="home-page">
    <!-- Hero Section -->
    <section class="hero">
        <h1>Find an eSIM deal that actually works</h1>
        <p class="hero-subtitle">Verified promo codes for the world's leading eSIM brands, checked and re-checked so you don't have to.</p>
        {% set totalCodes = 0 %}
        {% set totalProviders = 0 %}
        {% set maxDiscount = 0 %}

        {% for key, provider in codes %}
            {% if provider.codes and provider.codes.length > 0 %}
                {% set totalProviders = totalProviders + 1 %}
                {% set totalCodes = totalCodes + provider.codes.length %}

                {% for code in provider.codes %}
                    {% if not code.isInvalid %}
                        {% set discountNum = code.discount | replace('%', '') | replace('OFF', '') | replace('SPECIAL', '10') | replace('EXTRA', '10') | int %}
                        {% if discountNum > maxDiscount %}
                            {% set maxDiscount = discountNum %}
                        {% endif %}
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% endfor %}

        <div class="hero-search">
            <i class="fas fa-search" aria-hidden="true"></i>
            <label for="providerSearch" class="sr-only">Search providers</label>
            <input type="text" id="providerSearch" placeholder="Search providers (e.g. Holafly, Airalo)" autocomplete="off">
        </div>

        <div class="hero-stats">
            <span><i class="fas fa-circle-check"></i> {{ totalCodes }}+ verified codes</span>
            <span><i class="fas fa-globe"></i> {{ totalProviders }} providers</span>
            <span><i class="fas fa-tag"></i> Updated regularly</span>
        </div>

        <div class="hero-popular">
            <span>Popular:</span>
            <a href="/holafly/">Holafly</a>
            <a href="/airalo/">Airalo</a>
            <a href="/saily/">Saily</a>
            <a href="/nomad/">Nomad</a>
            <a href="/ubigi/">Ubigi</a>
        </div>
    </section>

    <!-- Our Code: always featured first, honestly framed (not a "best discount"
         superlative claim, which is what the old auto-computed section made -
         it could and did surface a competitor's code). -->
    {% set ourProviders = [] %}
    {% for key, provider in codes %}
        {% set ourCode = provider.codes | findCode("ADAMANDLINDS") %}
        {% if ourCode and ourCode.code == "ADAMANDLINDS" and not ourCode.isInvalid %}
            {% set ourProviders = ourProviders.concat([{key: key, name: provider.name, discount: ourCode.discount}]) %}
        {% endif %}
    {% endfor %}
    {% if ourProviders.length > 0 %}
    <section class="content-callout own-code-section">
        <h2><i class="fas fa-star"></i> Our Discount Code</h2>
        <p>
            <strong>ADAMANDLINDS</strong> is our own code &mdash; we built this site, so we show it first wherever it applies. It's currently active on:
        </p>
        <ul class="own-code-list">
            {% for p in ourProviders %}
            <li><a href="/{{ p.key }}/">{{ p.name }}</a> &mdash; {{ p.discount }}</li>
            {% endfor %}
        </ul>
        <p class="callout-meta">It isn't automatically the best public discount for every provider &mdash; each provider page lists every code we've verified so you can compare.</p>
    </section>
    {% endif %}

    <!-- Providers Grid -->
    <section class="providers-section" id="providers">
        <h2>Top eSIM Providers with Discount Codes</h2>
        <div class="providers-grid">
            {% for key, provider in codes %}
            <a href="/{{ key }}/" class="provider-card-link" data-search="{{ (provider.name + ' ' + provider.description) | lower }}">
                <div class="provider-card">
                    <div class="provider-logo">
                        {% if provider.logo %}
                            <img src="{{ provider.logo }}" alt="{{ provider.name }} logo" class="logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="logo-fallback" style="display: none;">{{ provider.name }}</div>
                        {% else %}
                            <div class="logo-fallback">{{ provider.name }}</div>
                        {% endif %}
                    </div>
                    <h3>{{ provider.name }}</h3>
                    {% if provider.primaryCode %}
                    <p class="discount">Save with code <strong>{{ provider.primaryCode }}</strong></p>
                    {% else %}
                    <p class="discount">Coming soon</p>
                    {% endif %}
                    <p>{{ provider.description }}</p>
                    <span class="provider-card-cta">View {{ provider.name }} deals <i class="fas fa-arrow-right"></i></span>
                </div>
            </a>
            {% endfor %}
        </div>
        <p class="providers-empty">No providers match that search.</p>
    </section>

    <div class="comparison-table-container">
      <h2>Compare eSIM Providers</h2>
      <table class="comparison-table">
        <thead>
          <tr>
            <th></th>
            <th></th>
            <th>Best Discount</th>
            <th>Rating</th>
            <th>Global Packages <i class="fa fa-globe"></i></th>
            <th>SMS Plans <i class="fa fa-mobile-alt"></i></th>
            <th>Unlimited Data Plans <i class="fa fa-bolt"></i></th>
          </tr>
        </thead>
        <tbody>
          {% for key, provider in codes %}
          {% set topCode = provider.codes | findCode(provider.primaryCode) %}
          <tr>
            <td>
                <a href="/{{ key }}/" class="provider-link-btn">
                {{ provider.name }}
                </a>
            </td>
            <td>
              <div class="provider-logo">
                {% if provider.logo %}
                  <img src="{{ provider.logo }}" alt="{{ provider.name }} logo" class="logo-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                  <span class="logo-fallback" style="display:none;">{{ provider.name }}</span>
                {% else %}
                  <span class="logo-fallback">{{ provider.name }}</span>
                {% endif %}
              </div>
            </td>
            <td class="best-discount-cell">
                {% if topCode and topCode.code and topCode.discount %}
                <strong>{{ topCode.discount }}</strong> <span class="discount-code">({{ topCode.code }})</span>
                {% if topCode.code == "ADAMANDLINDS" %}
                <span class="our-code-badge our-code-badge--table"><i class="fas fa-star"></i> Ours</span>
                {% endif %}
                {% else %}
                <span>&mdash;</span>
                {% endif %}
            </td>
            <td>
              {% if provider.totalScore %}
                <span class="star-rating">
                  {% set score = provider.totalScore | int %}
                  {% for i in range(1, 6) %}
                    {% if i <= score %}
                      <i class="fa fa-star" style="color: #ffc107;"></i>
                    {% else %}
                      <i class="fa fa-star" style="color: #e4e5e9;"></i>
                    {% endif %}
                  {% endfor %}
                  <span class="score-label">{{ score }}/5</span>
                </span>
              {% else %}
                <span>&mdash;</span>
              {% endif %}
            </td>
            <td>
              {% if provider.globalRegionalPackage %}
                <i class="fa fa-check"></i>
              {% else %}
                <i class="fa fa-times"></i>
              {% endif %}
            </td>
            <td>
              {% if provider.smsIncluded %}
                <i class="fa fa-check"></i>
              {% else %}
                <i class="fa fa-times"></i>
              {% endif %}
            </td>
            <td>
              {% if provider.unlimitedData %}
                <i class="fa fa-check"></i>
              {% else %}
                <i class="fa fa-times"></i>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <!-- What is an eSIM: educational/supporting content for readers who
         land here without already knowing - deliberately below the actual
         codes, not ahead of them. -->
    <section class="what-is-esim">
        <h2>What is an eSIM?</h2>
        <p>An eSIM (embedded SIM) is a digital SIM card that lets you connect to mobile networks without a physical SIM card. Perfect for international travel, eSIMs eliminate expensive roaming charges and give you instant connectivity in 170+ countries.</p>

        <div class="esim-benefits">
            <div class="benefit">
              <div class="benefit-icon">
                <i class="fas fa-sim-card" aria-hidden="true"></i>
              </div>
              <h3>No Physical SIM</h3>
              <p>Digital activation via QR code</p>
            </div>
            <div class="benefit">
              <div class="benefit-icon">
                <i class="fas fa-globe" aria-hidden="true"></i>
              </div>
              <h3>Global Coverage</h3>
              <p>Works in 170+ countries worldwide</p>
            </div>
            <div class="benefit">
              <div class="benefit-icon">
                <i class="fas fa-dollar-sign" aria-hidden="true"></i>
              </div>
              <h3>Cost Effective</h3>
              <p>Much cheaper than roaming charges</p>
            </div>
            </div>
        </div>
    </section>

</div>
