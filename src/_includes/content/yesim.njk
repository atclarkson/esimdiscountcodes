        "acceptedAnswer":{"@type":"Answer","text":"{{ provider.primaryCode }} gives {{ primary.discount | lower }} for first-time buyers. Returning customers should try WELCOMETOYESIM or TRAVELFREE instead."}
      },
      {
        "@type":"Question",
        "name":"What is a Yesim Pay & Fly plan?",
        "acceptedAnswer":{"@type":"Answer","text":"A balance-based option priced from $1.10/GB where you top up a dollar amount instead of buying a fixed block of data, and unused balance carries over to a future trip instead of expiring."}
      },
      {
        "@type":"Question",
        "name":"Can I get a refund if I don't use a Yesim plan?",
        "acceptedAnswer":{"@type":"Answer","text":"Yesim advertises a 30-day money-back guarantee on unused plans, which goes further than most competitors that only refund a plan that never connected."}
      },
      {
        "@type":"Question",
        "name":"Is Yesim the cheapest eSIM option?",
        "acceptedAnswer":{"@type":"Answer","text":"No, Yesim sits in the Expensive price bracket on this site. Airhub and Holafly are cheaper options for travelers focused on price per GB."}
      },
      {
        "@type":"Question",
        "name":"Does Yesim include a phone number?",
        "acceptedAnswer":{"@type":"Answer","text":"No, Yesim is data-only. Voice calls run over apps like WhatsApp or Viber using the data connection."}
      }
    ]
  }
  </script>
</div>
