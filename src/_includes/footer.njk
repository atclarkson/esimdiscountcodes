<!-- Footer -->
  <div class="footer-content">
    <div class="footer-section footer-section--providers">
      <h3>eSIM Providers</h3>
      <ul class="footer-providers-list">
        {% for key, provider in codes %}
        <li><a href="/{{ key }}">{{ provider.name }} Codes</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-section">
      <h3>About</h3>
      <ul>
        {% for item in about %}
        <li><a href="{{ item.url }}">{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-section">
      <h3>Resources</h3>
      <ul>
        {% for item in resources %}
        <li><a href="{{ item.url }}">{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    {% if comparisons and comparisons.length > 0 %}
    <div class="footer-section footer-compare-list">
      <h3>Compare Providers</h3>
      <ul>
        {% for item in comparisons %}
        <li><a href="/compare/{{ item.slug }}/">{{ codes[item.providerA].name }} vs {{ codes[item.providerB].name }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>

  <!-- Disclaimer Section -->
  <section class="disclaimer-section">
    <div class="disclaimer-card">
      <p>
        <i class="fas fa-info-circle"></i>
        Some codes and links on this site are affiliate codes, including our own (ADAMANDLINDS, where it applies) &mdash; we may earn a commission if you use one, at no extra cost to you. We show our own code more prominently, not because it's automatically the best deal. <a href="/about/">Full breakdown &rarr;</a>
      </p>
    </div>
  </section>

  <div class="footer-bottom">
    <p>&copy; {{ buildTime | fmtDate("yyyy") }} eSIMDiscountCodes.com. All rights reserved.</p>
  </div>
