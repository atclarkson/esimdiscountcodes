<!-- Footer -->
  <div class="footer-content">
    <div class="footer-section footer-section--providers">
      <h3>eSIM Providers</h3>
      <ul class="footer-providers-list">
        {% for key, provider in codes %}
        <li><a href="/{{ key }}">{{ provider.name }} Codes</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-section">
      <h3>About</h3>
      <ul>
        {% for item in about %}
        <li><a href="{{ item.url }}">{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-section">
      <h3>Resources</h3>
      <ul>
        {% for item in resources %}
        <li><a href="{{ item.url }}">{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <!-- Disclaimer Section -->
  <section class="disclaimer-section">
    <div class="disclaimer-card">
      <h3><i class="fas fa-info-circle"></i> Important Disclosure</h3>
      <p>
        <strong><i class="fas fa-handshake"></i> Affiliate Disclosure:</strong>
        Some codes and links on this site are affiliate codes and links,
        including our own (ADAMANDLINDS, where it applies). If you use one,
        we may earn a commission from the provider at no extra cost to you.
      </p>
      <p>
        <i class="fas fa-star"></i> We show our own code higher up and more
        prominently than other codes for the same provider. That's a choice
        we're making, not a ranking of which code saves you the most &mdash;
        our code is not always the best deal on the page, so it's worth
        checking the other codes listed too.
      </p>
      <p>
        <i class="fas fa-circle-check"></i> Every code on this site is
        confirmed active by us against what the provider currently advertises.
        Availability and terms can still change without notice, so always
        check the merchant's site at checkout.
      </p>
    </div>
  </section>

  <div class="footer-bottom">
    <p>&copy; {{ buildTime | fmtDate("yyyy") }} eSIMDiscountCodes.com. All rights reserved.</p>
  </div>
