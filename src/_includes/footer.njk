<!-- Footer -->
  {% set locale = locale or "en" %}
  <div class="footer-content">
    <div class="footer-section footer-section--providers">
      <h3>{{ 'footer.providers' | t(locale) }}</h3>
      <ul class="footer-providers-list">
        {% for key, provider in codes %}
        {% set alt = collections.i18nMap | i18nAlternates("provider:" + key) %}
        <li><a href="{{ alt[locale] or ('/' + key + '/') }}">{{ provider.name }} {{ 'footer.codesSuffix' | t(locale) }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-section">
      <h3>{{ 'footer.about' | t(locale) }}</h3>
      <ul>
        {% for item in about %}
        <li><a href="{{ item.url }}">{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-section">
      <h3>{{ 'footer.resources' | t(locale) }}</h3>
      <ul>
        {% for item in resources %}
        <li><a href="{{ item.url }}">{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    {% if comparisons and comparisons.length > 0 %}
    <div class="footer-section footer-compare-list">
      <h3>{{ 'footer.compareProviders' | t(locale) }}</h3>
      <ul>
        {% for item in comparisons %}
        {% set alt = collections.i18nMap | i18nAlternates("compare:" + item.slug) %}
        <li><a href="{{ alt[locale] or ('/compare/' + item.slug + '/') }}">{{ codes[item.providerA].name }} vs {{ codes[item.providerB].name }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>

  <!-- Disclaimer Section -->
  <section class="disclaimer-section">
    <div class="disclaimer-card">
      <p>
        <i class="fas fa-info-circle"></i>
        {{ 'footer.disclosure' | t(locale) }} <a href="/about/">{{ 'footer.fullBreakdown' | t(locale) }}</a>
      </p>
    </div>
  </section>

  <div class="footer-bottom">
    <p>&copy; {{ buildTime | fmtDate("yyyy") }} eSIMDiscountCodes.com. {{ 'footer.rightsReserved' | t(locale) }}</p>
  </div>
