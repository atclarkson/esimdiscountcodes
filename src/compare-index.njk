{% set categories = [
  {
    title: "Unlimited vs. Pay-Per-GB",
    intro: "Flat-rate unlimited plans against pay-by-the-gigabyte pricing. Which philosophy actually saves you money depends on how much data you use.",
    slugs: ["holafly-vs-airalo", "holafly-vs-saily", "holafly-vs-alosim", "holafly-vs-ubigi", "holafly-vs-nomad", "holafly-vs-orange", "airhub-vs-holafly"]
  },
  {
    title: "Budget Pay-Per-GB Showdowns",
    intro: "The cheapest per-gigabyte providers on this site, compared head to head.",
    slugs: ["airalo-vs-saily", "alosim-vs-airalo", "airhub-vs-instabridge", "airhub-vs-redteago", "airhub-vs-yesim", "airhub-vs-bnesim", "yesim-vs-redteago", "instabridge-vs-redteago", "yesim-vs-upesim"]
  },
  {
    title: "Phone Number & Voice Features",
    intro: "Providers that bundle, or sell as an add-on, a real or virtual phone number alongside data.",
    slugs: ["alosim-vs-simlocal", "bytesim-vs-alosim", "esimcardus-vs-alosim", "airhub-vs-alosim", "bytesim-vs-redteago", "airhub-vs-bytesim", "saily-vs-alosim", "esimcardus-vs-bytesim"]
  },
  {
    title: "Carrier, MVNO & Long-Term Plans",
    intro: "Telecom-backed bundles, recurring subscriptions, and plans built for longer trips rather than a single short visit.",
    slugs: ["saily-vs-ubigi", "nomad-vs-ubigi", "orange-vs-ubigi", "bnesim-vs-orange", "bnesim-vs-nomad", "airalo-vs-nomad"]
  },
  {
    title: "Refund Policies & Guarantees",
    intro: "What actually happens if an eSIM doesn't work, compared side by side.",
    slugs: ["simlocal-vs-instabridge", "esimcardus-vs-upesim", "simlocal-vs-upesim"]
  }
] %}

<div class="provider-page compare-hub-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><span aria-current="page">Compare eSIM Providers</span></li>
    </ol>
  </nav>

  <h1 class="vs-title">Compare eSIM Providers</h1>
  <p class="compare-hub-intro">
    Every head-to-head comparison on this site, grouped by what actually drives the decision, not just an alphabetical dump. Pick the category that matches your trip, then read the matchup.
  </p>

  {% macro compareCard(cmp) %}
  {% set pA = codes[cmp.providerA] %}
  {% set pB = codes[cmp.providerB] %}
  <a class="compare-hub-card" href="/compare/{{ cmp.slug }}/">
    <div class="compare-hub-card-vs">
      {% if pA.logo %}<img src="{{ pA.logo }}" alt="{{ pA.name }} logo">{% endif %}
      <span class="compare-hub-divider">VS</span>
      {% if pB.logo %}<img src="{{ pB.logo }}" alt="{{ pB.name }} logo">{% endif %}
    </div>
    <h3>{{ pA.name }} vs {{ pB.name }}</h3>
    <span class="compare-hub-card-cta">Read the comparison <i class="fas fa-arrow-right"></i></span>
  </a>
  {% endmacro %}

  {% set usedSlugs = [] %}
  {% for category in categories %}
    {% set usedSlugs = usedSlugs.concat(category.slugs) %}
  {% endfor %}
  {% set leftover = comparisons | excludeSlugs(usedSlugs) | reverse %}

  {% for category in categories %}
  <section class="compare-hub-category">
    <h2>{{ category.title }}</h2>
    <p class="compare-hub-category-intro">{{ category.intro }}</p>
    <div class="compare-hub-grid">
      {% for cmp in comparisons | resolveSlugs(category.slugs) %}
      {{ compareCard(cmp) }}
      {% endfor %}
    </div>
  </section>
  {% endfor %}

  {% if leftover.length > 0 %}
  <section class="compare-hub-category">
    <h2>More Comparisons</h2>
    <p class="compare-hub-category-intro">Newer matchups that haven't been sorted into a category above yet.</p>
    <div class="compare-hub-grid">
      {% for cmp in leftover %}
      {{ compareCard(cmp) }}
      {% endfor %}
    </div>
  </section>
  {% endif %}
</div>
