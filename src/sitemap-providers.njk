---
permalink: /sitemap-providers.xml
eleventyExcludeFromCollections: true
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {# One <url> entry per LOCALE VERSION of each provider page (English
     plus any of German/Spanish that exist), each carrying the full
     hreflang alternate set including itself - the pattern Google's
     sitemap i18n docs recommend, rather than only listing the English
     URL and hoping crawlers follow its hreflang links to the rest. #}
  {% for key, provider in codes %}
  {% set alternates = collections.i18nMap | i18nAlternates("provider:" + key) %}
  {% for loc, locUrl in alternates %}
  <url>
    <loc>{{ locUrl | url | absoluteUrl(site.url) }}</loc>
    <lastmod>
      {% if provider.codesLastUpdated %}
        {{ provider.codesLastUpdated | date("YYYY-MM-DD") }}
      {% else %}
        {{ buildTime | date("YYYY-MM-DD") }}
      {% endif %}
    </lastmod>
    <changefreq>{% if provider.isPopular %}daily{% else %}weekly{% endif %}</changefreq>
    <priority>{% if provider.isPopular %}0.9{% else %}0.8{% endif %}</priority>
    {% if alternates | length > 1 %}
      {{ alternates | hreflangs(site.url) | safe }}
    {% endif %}
  </url>
  {% endfor %}
  {% endfor %}

  {# Optional static groups #}
  {% for item in about %}
  <url>
    <loc>{{ item.url | url | absoluteUrl(site.url) }}</loc>
    <lastmod>{{ buildTime | date("YYYY-MM-DD") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  {% endfor %}

  {% for item in resources %}
  <url>
    <loc>{{ item.url | url | absoluteUrl(site.url) }}</loc>
    <lastmod>{{ buildTime | date("YYYY-MM-DD") }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}
</urlset>
