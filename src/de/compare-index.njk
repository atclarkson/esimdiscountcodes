{% set categories = [
  {
    title: "Unbegrenzt vs. Bezahlung pro GB",
    intro: "Pauschale Unbegrenzt-Tarife gegen Bezahlung pro Gigabyte. Welche Philosophie wirklich Geld spart, hängt davon ab, wie viele Daten du verbrauchst.",
    slugs: ["holafly-vs-airalo", "holafly-vs-saily", "holafly-vs-alosim", "holafly-vs-ubigi", "holafly-vs-nomad", "holafly-vs-orange", "airhub-vs-holafly"]
  },
  {
    title: "Günstige Pro-GB-Duelle",
    intro: "Die günstigsten Pro-Gigabyte-Anbieter dieser Seite im direkten Vergleich.",
    slugs: ["airalo-vs-saily", "alosim-vs-airalo", "airhub-vs-instabridge", "airhub-vs-redteago", "airhub-vs-yesim", "airhub-vs-bnesim", "yesim-vs-redteago", "instabridge-vs-redteago", "yesim-vs-upesim"]
  },
  {
    title: "Telefonnummer & Sprachfunktionen",
    intro: "Anbieter, die eine echte oder virtuelle Telefonnummer zu den Daten dazu bündeln oder als Zukauf verkaufen.",
    slugs: ["alosim-vs-simlocal", "bytesim-vs-alosim", "esimcardus-vs-alosim", "airhub-vs-alosim", "bytesim-vs-redteago", "airhub-vs-bytesim", "saily-vs-alosim", "esimcardus-vs-bytesim"]
  },
  {
    title: "Mobilfunkanbieter, MVNO & Langzeit-Tarife",
    intro: "Tarife etablierter Netzbetreiber, wiederkehrende Abos und Pläne für längere Reisen statt eines einzelnen kurzen Besuchs.",
    slugs: ["saily-vs-ubigi", "nomad-vs-ubigi", "orange-vs-ubigi", "bnesim-vs-orange", "bnesim-vs-nomad", "airalo-vs-nomad"]
  },
  {
    title: "Rückerstattung & Garantien",
    intro: "Was tatsächlich passiert, wenn eine eSIM nicht funktioniert, im direkten Vergleich.",
    slugs: ["simlocal-vs-instabridge", "esimcardus-vs-upesim", "simlocal-vs-upesim"]
  }
] %}

<div class="provider-page compare-hub-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="{{ 'de' | homeUrl }}">Startseite</a></li>
      <li><span aria-current="page">eSIM-Anbieter im Vergleich</span></li>
    </ol>
  </nav>

  <h1 class="vs-title">eSIM-Anbieter im Vergleich</h1>
  <p class="compare-hub-intro">
    Alle direkten Vergleiche dieser Seite, gruppiert nach dem, was für die Entscheidung wirklich zählt, statt einer alphabetischen Liste. Wähle die Kategorie, die zu deiner Reise passt, und lies den Vergleich.
  </p>

  {% macro compareCard(cmp) %}
  {% set pA = codes[cmp.providerA] %}
  {% set pB = codes[cmp.providerB] %}
  {% set altCmp = collections.i18nMap | i18nAlternates("compare:" + cmp.slug) %}
  {% set cmpUrl = altCmp.de or ("/compare/" + cmp.slug + "/") %}
  <a class="compare-hub-card" href="{{ cmpUrl }}">
    <div class="compare-hub-card-vs">
      {% if pA.logo %}<img src="{{ pA.logo }}" alt="{{ pA.name }} Logo">{% endif %}
      <span class="compare-hub-divider">VS</span>
      {% if pB.logo %}<img src="{{ pB.logo }}" alt="{{ pB.name }} Logo">{% endif %}
    </div>
    <h3>{{ pA.name }} vs {{ pB.name }}</h3>
    <span class="compare-hub-card-cta">Vergleich lesen <i class="fas fa-arrow-right"></i></span>
  </a>
  {% endmacro %}

  {% set usedSlugs = [] %}
  {% for category in categories %}
    {% set usedSlugs = usedSlugs.concat(category.slugs) %}
  {% endfor %}
  {% set leftover = comparisons | excludeSlugs(usedSlugs) | reverse %}

  {% for category in categories %}
  <section class="compare-hub-category">
    <h2>{{ category.title }}</h2>
    <p class="compare-hub-category-intro">{{ category.intro }}</p>
    <div class="compare-hub-grid">
      {% for cmp in comparisons | resolveSlugs(category.slugs) %}
      {{ compareCard(cmp) }}
      {% endfor %}
    </div>
  </section>
  {% endfor %}

  {% if leftover.length > 0 %}
  <section class="compare-hub-category">
    <h2>Weitere Vergleiche</h2>
    <p class="compare-hub-category-intro">Neuere Gegenüberstellungen, die noch keiner Kategorie oben zugeordnet wurden.</p>
    <div class="compare-hub-grid">
      {% for cmp in leftover %}
      {{ compareCard(cmp) }}
      {% endfor %}
    </div>
  </section>
  {% endif %}
</div>
