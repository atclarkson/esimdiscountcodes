---
layout: base.njk
pagination:
  data: esProviderEntries
  size: 1
  alias: providerEntry
  addAllPagesToCollections: true
permalink: "/es/{{ providerEntry[0] }}/"
eleventyComputed:
  title: "{% set esO = codesEs[providerEntry[0]] %}{% if providerEntry[1].primaryCode %}{{ providerEntry[1].primaryCode }} - {{ (esO.codes[providerEntry[1].primaryCode].discount if (esO and esO.codes and esO.codes[providerEntry[1].primaryCode])) or providerEntry[1].codes[0].discount }} de descuento en {{ providerEntry[1].name }} eSIM (Verificado {{ buildTime | fmtDate('LLLL yyyy') }}){% else %}Códigos de descuento {{ providerEntry[1].name }} - Verificado {{ buildTime | fmtDate('LLLL yyyy') }}{% endif %}"
  description: "{% set esO = codesEs[providerEntry[0]] %}{% if providerEntry[1].primaryCode %}{{ providerEntry[1].primaryCode }}: {{ (esO.codes[providerEntry[1].primaryCode].discount if (esO and esO.codes and esO.codes[providerEntry[1].primaryCode])) or providerEntry[1].codes[0].discount }} de descuento en planes eSIM de {{ providerEntry[1].name }}. Verificado el {{ buildTime | fmtDate('d LLLL yyyy') }}. Ahorra en datos móviles de viaje con códigos probados.{% else %}Todavía no hemos encontrado un código de descuento verificado de {{ providerEntry[1].name }} - comprobado el {{ buildTime | fmtDate('d LLLL yyyy') }}. {{ (esO.description if esO) or providerEntry[1].description }}{% endif %}"
  canonical: "{{ page.url | url | absoluteUrl(site.url) }}"
  providerKey: "{{ providerEntry[0] }}"
  provider: "{{ providerEntry[1] }}"
  providerName: "{{ providerEntry[1].name }}"
  ogImage: "{{ providerEntry[1].ogImage or '/assets/og-image.jpg' }}"
  ogLocale: "es_ES"
  modifiedISO: "{{ (providerEntry[1].codesLastUpdated or buildTime) | fmtISO }}"
  buildPretty: "{{ buildTime | fmtDate('LLLL d, yyyy') }}"
  renderFaq: true
  translationKey: "provider:{{ providerEntry[0] }}"
  locale: "es"
---

{% set providerKey = providerEntry[0] %}
{% set provider = providerEntry[1] %}
{% set buildPretty = buildTime | fmtDate("d 'de' LLLL 'de' yyyy") %}
{% set buildMonthYear = buildTime | fmtDate("LLLL yyyy") %}
{% set lastModISO = (provider.codesLastUpdated or buildTime) | fmtISO %}
{% set locale = "es" %}
{# Spanish text overrides for this provider's discount/description fields,
   from src/_data/codesEs.json - codes.json itself stays English-only and
   untouched. Falls back to the English text for any code not yet
   overridden here, so a partially-translated provider never renders
   blank. #}
{% set esOverride = codesEs[providerKey] %}
{% set providerDescription = (esOverride.description if esOverride) or provider.description %}
{% set hasContent = providerKey | hasContentFile("es") %}


<div class="provider-page" data-provider="{{ providerKey }}">
    <!-- Breadcrumbs for SEO and UX -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
            <li><a href="{{ 'es' | homeUrl }}">Inicio</a></li>
            <li><span aria-current="page">Códigos de descuento de {{ provider.name }}</span></li>
        </ol>
    </nav>

    <!-- Provider Header with Logo (for all pages) -->
    <header class="provider-header">
        <div class="provider-logo">
            {% if provider.logo %}
                <img src="{{ provider.logo }}" alt="Logo de {{ provider.name }}" class="logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div class="logo-fallback" style="display: none;">{{ provider.name }}</div>
            {% else %}
                <div class="logo-fallback">{{ provider.name }}</div>
            {% endif %}
        </div>
        <h1>Códigos de descuento de {{ provider.name }}</h1>
        <p class="subtitle">{{ providerDescription }}</p>
    </header>

    {% if provider.codes and provider.codes.length > 0 %}
        <!-- Has Codes -->
        <section class="codes-section">
            <h2>Los mejores códigos de descuento de {{ provider.name }}</h2>


           {% set outUrl = provider.affiliateUrl or provider.url %}
           {% set isAffiliateOut = provider.affiliateUrl and outUrl == provider.affiliateUrl %}
           {% for code in provider.codes | sortedCodes %}
  {% set isInvalid = code.isInvalid or false %}
  {% set verifiedISO = (code.lastTested or provider.codesLastUpdated or buildTime) | fmtISO %}
  {% set verifiedPretty = (code.lastTested or provider.codesLastUpdated or buildTime) | fmtDate("d 'de' LLLL 'de' yyyy") %}
  {% set esCode = esOverride.codes[code.code] if (esOverride and esOverride.codes and esOverride.codes[code.code]) else null %}
  {% set codeDiscount = (esCode.discount if esCode) or code.discount %}
  {% set codeDescription = (esCode.description if esCode) or code.description %}

  <div class="coupon-card {% if code.isPrimary and not isInvalid %}primary-code{% endif %} {% if isInvalid %}invalid-code{% endif %}">
    <div class="coupon-header">
      <h3>
        {% if isInvalid %}<s>{{ codeDiscount }}</s>{% else %}{{ codeDiscount }}{% endif %}
      </h3>
      {% if code.type == "affiliate" and not isInvalid %}
      <span class="our-code-badge">
        <i class="fas fa-star"></i> Nuestro código
      </span>
      {% endif %}
      {% if code.verified and not isInvalid %}
      <span class="verified-badge">
        <i class="fas fa-circle-check" style="color:#4D8374;"></i>
        <time datetime="{{ verifiedISO }}">Confirmado activo el {{ verifiedPretty }}</time>
      </span>
      {% elif isInvalid %}
      <span class="invalid-badge">
        <i class="fas fa-circle-xmark" style="color:#79252F;"></i>
        <span>Ya no funciona</span>
      </span>
      {% endif %}
    </div>

    <div class="coupon-code">
      <button class="copy-code-btn {% if isInvalid %}invalid-btn{% endif %}"
              data-code="{{ code.code }}"
              {% if isInvalid %}disabled{% endif %}>
        <i class="fas fa-{% if isInvalid %}times{% else %}copy{% endif %}"></i>
        <span class="code-text {% if isInvalid %}strikethrough{% endif %}">{{ code.code }}</span>
        <span class="copy-label">{% if isInvalid %}No válido{% else %}Copiar código{% endif %}</span>
      </button>
      {% if outUrl %}
      <a class="get-deal-btn"
         href="{{ outUrl }}"
         target="_blank"
         rel="{% if isAffiliateOut %}sponsored noopener{% else %}noopener{% endif %}">
        <i class="fas fa-arrow-up-right-from-square"></i>
        <span>Ir a {{ provider.name }}<span class="sr-only"> (abre la web de {{ provider.name }} en una pestaña nueva)</span></span>
      </a>
      {% endif %}
    </div>

    <p class="coupon-description {% if isInvalid %}invalid-description{% endif %}">
      {% if isInvalid %}
        <strong>Este código ya no funciona.</strong> {{ codeDescription }}
      {% else %}
        {{ codeDescription }}
      {% endif %}
    </p>

    <!-- Show proof section for all codes; hidden entirely if the image fails to load -->
    <div class="proof-section {% if isInvalid %}invalid-proof{% endif %}">
      <div class="proof-label {% if isInvalid %}invalid-label{% endif %}">
        <i class="fas fa-{% if isInvalid %}times-circle{% else %}camera{% endif %}"></i>
        {% if isInvalid %}Prueba de que no funciona{% else %}Prueba de que funciona{% endif %}
      </div>
      <div class="proof-thumbnail {% if isInvalid %}invalid-thumbnail{% endif %}"
           data-provider="{{ providerKey }}"
           data-code="{{ code.code }}"
           data-invalid="{{ isInvalid }}">
        <img src="/assets/{{ providerKey }}/{{ code.code }}.png"
             alt="Prueba de que el código {{ code.code }} de {{ provider.name }} {% if isInvalid %}no funciona{% else %}funciona{% endif %}"
             onerror="this.closest('.proof-section').style.display='none';">
      </div>
    </div>

    <!-- Only show feedback for valid codes -->
    {% if not isInvalid %}
    <div class="feedback-buttons">
      <button class="feedback-btn thumbs-up" data-feedback="up">
        <i class="fas fa-thumbs-up"></i>
      </button>
      <button class="feedback-btn thumbs-down" data-feedback="down">
        <i class="fas fa-thumbs-down"></i>
      </button>
    </div>
    {% endif %}
  </div>
{% endfor %}

        </section>
{# Affiliate disclosure #}
<section class="code-disclosure">
  <p>
    <i class="fas fa-circle-info"></i>
    Aviso: algunos códigos de esta página son códigos y enlaces de afiliado, incluido el nuestro (<strong>ADAMANDLINDS</strong>, cuando corresponde). Si usas uno, podemos recibir una comisión. Mostramos nuestro propio código más arriba porque es nuestro, no porque sea automáticamente la mejor oferta. Hemos confirmado que cada código aquí sigue activo, pero revisa la lista antes de copiar: un código público más abajo podría ahorrarte más. Consulta nuestra <a href="/about/">página sobre nosotros</a> (en inglés) para el detalle completo.
  </p>
</section>
    {% endif %}

    {% if hasContent %}
        <!-- Content Section (real Spanish article, shown even for a provider with no working code right now) -->
        <section class="content-section">
            {% include "content/es/" + providerKey + ".njk" %}
        </section>

    {% elif not (provider.codes and provider.codes.length > 0) %}
        <!-- No code and no article yet, but still send the click somewhere -->
        {% set outUrl = provider.affiliateUrl or provider.url %}
        {% set isAffiliateOut = provider.affiliateUrl and outUrl == provider.affiliateUrl %}
        <section class="coming-soon-section">
            <div class="coming-soon-content">
                <h2>Todavía no hay código de descuento</h2>
                <p>Todavía no hemos encontrado un código de descuento de {{ provider.name }} que funcione. A veces tienen sus propias ofertas, así que merece la pena mirar en el momento de pagar.</p>

                {% if outUrl %}
                <a class="get-deal-btn coming-soon-shop-btn"
                   href="{{ outUrl }}"
                   target="_blank"
                   rel="{% if isAffiliateOut %}sponsored noopener{% else %}noopener{% endif %}">
                    <i class="fas fa-arrow-up-right-from-square"></i>
                    <span>Comprobar descuentos en {{ provider.name }}<span class="sr-only"> (abre la web de {{ provider.name }} en una pestaña nueva)</span></span>
                </a>
                {% if isAffiliateOut %}
                <p class="coming-soon-disclosure">Este es nuestro enlace de afiliado. Podemos recibir una comisión si compras a través de él, sin coste adicional para ti.</p>
                {% endif %}
                {% endif %}
            </div>
        </section>
    {% endif %}
</div>

<!-- Modal for enlarged proof image -->
<div class="proof-modal" id="proofModal">
  <div class="proof-modal-content">
    <button class="modal-close" aria-label="Cerrar" onclick="closeProofModal()">&times;</button>
    <h3 class="modal-title" id="modalTitle">Captura de prueba</h3>
    <img id="modalImage" src="" alt="">
  </div>
</div>
