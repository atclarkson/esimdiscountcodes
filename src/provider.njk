---
layout: base.njk
pagination:
  data: providerEntries
  size: 1
  alias: providerEntry
permalink: "/{{ providerEntry[0] }}/"
eleventyComputed:
  title: "{{ providerEntry[1].primaryCode }} - {{ providerEntry[1].codes[0].discount }} Off {{ providerEntry[1].name }} eSIM (Verified {{ buildTime | fmtDate('LLLL yyyy') }})"
  description: "✅ {{ providerEntry[1].primaryCode }}: {{ providerEntry[1].codes[0].discount }} off {{ providerEntry[1].name }} eSIM plans. Verified {{ buildTime | fmtDate('LLLL d, yyyy') }}. Save on travel data with tested codes."
  canonical: "{{ page.url | url | absoluteUrl(site.url) }}"
  providerKey: "{{ providerEntry[0] }}"
  provider: "{{ providerEntry[1] }}"
  ogImage: "{{ providerEntry[1].ogImage or '/assets/og-image.jpg' }}"
  modifiedISO: "{{ (providerEntry[1].codesLastUpdated or buildTime) | fmtISO }}"
  buildPretty: "{{ buildTime | fmtDate('LLLL d, yyyy') }}"
  renderFaq: true
---

{% set providerKey = providerEntry[0] %}
{% set provider = providerEntry[1] %}
{% set buildPretty = buildTime | fmtDate("LLLL d, yyyy") %}
{% set buildMonthYear = buildTime | fmtDate("LLLL yyyy") %}
{% set lastModISO = (provider.codesLastUpdated or buildTime) | fmtISO %}


<div class="provider-page" data-provider="{{ providerKey }}">
    <!-- Breadcrumbs for SEO and UX -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
            <li><a href="/">Home</a></li>
            <li><span>{{ provider.name }} Discount Codes</span></li>
        </ol>
    </nav>

    <!-- Provider Header with Logo (for all pages) -->
    <header class="provider-header">
        <div class="provider-logo">
            {% if provider.logo %}
                <img src="{{ provider.logo }}" alt="{{ provider.name }} logo" class="logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div class="logo-fallback" style="display: none;">{{ provider.name }}</div>
            {% else %}
                <div class="logo-fallback">{{ provider.name }}</div>
            {% endif %}
        </div>
        <h1>{{ provider.name }} Discount Codes</h1>
        <p class="subtitle">{{ provider.description }}</p>
    </header>

    {% if provider.codes and provider.codes.length > 0 %}
        <!-- Has Codes -->
        <section class="codes-section">
            <h2>Top {{ provider.name }} Discount Codes for {{ buildPretty }}</h2>


           {% set outUrl = provider.affiliateUrl or provider.url %}
           {% set isAffiliateOut = provider.affiliateUrl and outUrl == provider.affiliateUrl %}
           {% for code in provider.codes | sortedCodes %}
  {% set isInvalid = code.isInvalid or false %}
  {% set verifiedISO = (code.lastTested or provider.codesLastUpdated or buildTime) | fmtISO %}
  {% set verifiedPretty = (code.lastTested or provider.codesLastUpdated or buildTime) | fmtDate("LLLL d, yyyy") %}

  <div class="coupon-card {% if code.isPrimary and not isInvalid %}primary-code{% endif %} {% if isInvalid %}invalid-code{% endif %}">
    <div class="coupon-header">
      <h3>
        {% if isInvalid %}<s>{{ code.discount }}</s>{% else %}{{ code.discount }}{% endif %}
      </h3>
      {% if code.type == "affiliate" and not isInvalid %}
      <span class="our-code-badge">
        <i class="fas fa-star"></i> Our Code
      </span>
      {% endif %}
      {% if code.verified and not isInvalid %}
      <span class="verified-badge">
        <i class="fas fa-circle-check" style="color:#10b981;"></i>
        <time datetime="{{ verifiedISO }}">Confirmed active {{ verifiedPretty }}</time>
      </span>
      {% elif isInvalid %}
      <span class="invalid-badge">
        <i class="fas fa-circle-xmark" style="color:#dc2626;"></i>
        <span>No longer works</span>
      </span>
      {% endif %}
    </div>

    <div class="coupon-code">
      <button class="copy-code-btn {% if isInvalid %}invalid-btn{% endif %}"
              data-code="{{ code.code }}"
              {% if isInvalid %}disabled{% endif %}>
        <i class="fas fa-{% if isInvalid %}times{% else %}copy{% endif %}"></i>
        <span class="code-text {% if isInvalid %}strikethrough{% endif %}">{{ code.code }}</span>
        <span class="copy-label">{% if isInvalid %}Invalid{% else %}Copy code{% endif %}</span>
      </button>
      {% if outUrl %}
      <a class="get-deal-btn"
         href="{{ outUrl }}"
         target="_blank"
         rel="{% if isAffiliateOut %}sponsored noopener{% else %}noopener{% endif %}">
        <i class="fas fa-arrow-up-right-from-square"></i>
        <span>Shop {{ provider.name }}</span>
      </a>
      {% endif %}
    </div>

    <p class="coupon-description {% if isInvalid %}invalid-description{% endif %}">
      {% if isInvalid %}
        <strong>This code no longer works.</strong> {{ code.description }}
      {% else %}
        {{ code.description }}
      {% endif %}
    </p>

    <!-- Show proof section for all codes -->
    <div class="proof-section {% if isInvalid %}invalid-proof{% endif %}">
      <div class="proof-label {% if isInvalid %}invalid-label{% endif %}">
        <i class="fas fa-{% if isInvalid %}times-circle{% else %}camera{% endif %}"></i>
        {% if isInvalid %}Proof It Doesn't Work{% else %}The Proof{% endif %}
      </div>
      <div class="proof-thumbnail {% if isInvalid %}invalid-thumbnail{% endif %}" 
           data-provider="{{ providerKey }}" 
           data-code="{{ code.code }}"
           data-invalid="{{ isInvalid }}">
        <img src="/assets/{{ providerKey }}/{{ code.code }}.png" 
             alt="Proof that {{ code.code }} code {% if isInvalid %}doesn't work{% else %}works{% endif %} for {{ provider.name }}"
             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
        <div class="proof-fallback {% if isInvalid %}invalid-fallback{% endif %}" style="display: none;">
          <i class="fas fa-{% if isInvalid %}exclamation-triangle{% else %}image{% endif %}"></i>
          No proof<br>available
        </div>
      </div>
    </div>

    <!-- Only show feedback for valid codes -->
    {% if not isInvalid %}
    <div class="feedback-buttons">
      <button class="feedback-btn thumbs-up" data-feedback="up">
        <i class="fas fa-thumbs-up"></i>
      </button>
      <button class="feedback-btn thumbs-down" data-feedback="down">
        <i class="fas fa-thumbs-down"></i>
      </button>
    </div>
    {% endif %}
  </div>
{% endfor %}

        </section>
{# Affiliate disclosure #}
<section class="code-disclosure">
  <p>
    <i class="fas fa-circle-info"></i>
    Heads up: some codes on this page are affiliate codes and links, including our own (<strong>ADAMANDLINDS</strong> where it applies) — if you use one, we may earn a commission. We put our own code higher up on the page because it's ours, not because it's automatically the best deal. Every code here is confirmed still active by us, but check the list before you copy — a public code below ours might save you more. See our <a href="/about/">about page</a> for the full breakdown.
  </p>
</section>

        <!-- Content Section (check for markdown files) -->
        <section class="content-section">
            {% include "content/" + providerKey + ".njk" %}
        </section>
        
    {% else %}
        <!-- Coming Soon -->
        <section class="coming-soon-section">
            <div class="coming-soon-content">
                <h2><i class="fas fa-clock"></i> Coming Soon</h2>
                <p>We're working hard to bring you the best {{ provider.name }} discount codes and promo codes. Check back soon for verified codes that will save you money on your eSIM plans.</p>
                
                <div class="explore-section">
                    <h3><i class="fas fa-compass"></i> Explore Other Providers</h3>
                    <p>While you wait, check out our verified discount codes for other eSIM providers:</p>
                    <div class="provider-links">
                        {% for key, otherProvider in codes %}
                            {% if otherProvider.codes and otherProvider.codes.length > 0 and key != providerKey %}
                            <a href="/{{ key }}" class="provider-link">
                                <span class="provider-name">{{ otherProvider.name }}</span>
                                <span class="provider-offer">Save with verified codes</span>
                            </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </section>
    {% endif %}
</div>

<!-- Modal for enlarged proof image -->
<div class="proof-modal" id="proofModal">
  <div class="proof-modal-content">
    <button class="modal-close" onclick="closeProofModal()">&times;</button>
    <h3 class="modal-title" id="modalTitle">Code Verification Proof</h3>
    <img id="modalImage" src="" alt="">
  </div>
</div>